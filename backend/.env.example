# Database
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/hospital_rbac_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SESSION=3600
REDIS_TTL_PERMISSION_CACHE=1800

# API
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=debug

# JWT - CHANGE IN PRODUCTION!
JWT_SECRET=dev-secret-key-change-in-production-please-use-64-chars-min
JWT_EXPIRY=3600
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-please-use-64-chars
JWT_REFRESH_EXPIRY=604800

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=3600
SESSION_ABSOLUTE_TIMEOUT=86400
PASSWORD_RESET_TOKEN_EXPIRY=900

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Audit
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=365
